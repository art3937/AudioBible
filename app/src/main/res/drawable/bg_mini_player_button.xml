<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Размер задаётся в layout, но на всякий случай добавим минимальный размер -->
    <size android:width="56dp" android:height="56dp" />

    <!-- Фоновый цвет круга (использует тему) -->
    <solid android:color="?attr/colorSurface" />

    <!-- Тонкая окантовка для глубины -->
    <stroke android:width="0.5dp" android:color="#20000000" />

    <padding android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp" />
</shape>