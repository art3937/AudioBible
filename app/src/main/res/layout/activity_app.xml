<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="10dp"
    tools:context=".fragments.AppActivity">

    <!-- Компонент верхней панели (чердака) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />


    <!-- Навигационный контейнер для фрагментов (вместо старого тега <fragment>) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_main"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"

        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_main" />



    <!-- ================= НИЖНИЙ МИНИ-ПЛЕЕР (плавающий) ================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layoutMiniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"

        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        tools:visibility="visible">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp"
            android:alpha="0.25"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/one" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- Верхняя строчка: Название книги и главы (по центру) -->
            <TextView
                android:id="@+id/textMiniPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:gravity="center"
                android:singleLine="true"
                android:text="Загрузка..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <!-- Средняя строчка: Блок управления (Кнопка Play по центру!) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Кнопка Назад на 15 секунд -->
                <ImageButton
                    android:id="@+id/buttonMiniPlayerRewind"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_mini_player_button"
                    android:contentDescription="Назад на 15 секунд"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_media_rew"
                    app:tint="?attr/colorOnSurface" />

                <!-- Кнопка Play/Pause по центру -->
                <ImageButton
                    android:id="@+id/buttonMiniPlayerPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_mini_player_button"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/play"
                    app:tint="?attr/colorOnSurface" />

                <!-- Кнопка Вперед на 15 секунд -->
                <ImageButton
                    android:id="@+id/buttonMiniPlayerForward"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_mini_player_button"
                    android:contentDescription="Вперед на 15 секунд"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_media_ff"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Нижняя строчка: Ползунок и временные метки -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface" />

                <SeekBar
                    android:id="@+id/seekBarMiniPlayer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/textTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>
